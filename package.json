{
  "name": "pdf-worker",
  "version": "1.0.0",
  "private": true,
  "description": "PDF Worker: PDF tools that run in your browser, also packaged as an Android app with Capacitor.",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && npx cap sync android",
    "icons": "python scripts/make_icons.py",
    "pages": "node scripts/build-pages.mjs && python scripts/make_og.py"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9"
  }
}
